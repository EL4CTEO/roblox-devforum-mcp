{
  "name": "roblox-devforum-mcp",
  "version": "1.4.0",
  "description": "MCP server that searches the Roblox DevForum and official creator docs so AI coding agents can debug Roblox games against real community and engine knowledge.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "roblox",
    "roblox-studio",
    "roblox-development",
    "devforum",
    "luau",
    "ai",
    "ai-agents",
    "llm",
    "claude",
    "claude-code",
    "game-development",
    "rust",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "license": "MIT",
  "author": "EL4CTEO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EL4CTEO/roblox-devforum-mcp.git"
  },
  "homepage": "https://github.com/EL4CTEO/roblox-devforum-mcp#readme",
  "bugs": {
    "url": "https://github.com/EL4CTEO/roblox-devforum-mcp/issues"
  },
  "bin": {
    "roblox-devforum-mcp": "bin/roblox-devforum-mcp.js"
  },
  "files": [
    "bin/roblox-devforum-mcp.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "roblox-devforum-mcp-darwin-arm64": "1.4.0",
    "roblox-devforum-mcp-darwin-x64": "1.4.0",
    "roblox-devforum-mcp-linux-arm64": "1.4.0",
    "roblox-devforum-mcp-linux-x64": "1.4.0",
    "roblox-devforum-mcp-win32-x64": "1.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "cargo build --release",
    "test": "cargo test",
    "inspect": "npx -y @modelcontextprotocol/inspector target/release/roblox-devforum-mcp",
    "npm:platforms": "node scripts/npm-platforms.mjs"
  }
}
